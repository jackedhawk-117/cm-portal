# ---------------------------------------------------------------------------
# CM Kerala – Public Grievance Redressal Portal
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
# Local example: postgresql://postgres:postgres@localhost:5432/cm_portal
# Neon example:  postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/cm_portal

# Separate database used by the Jest test-suite (optional; defaults to DATABASE_URL + "_test")
DATABASE_URL_TEST=postgresql://app:app@127.0.0.1:5432/cm_portal_test

# Auth – generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma separated list of allowed origins for cross-origin dev clients.
# In production the API and the SPA are served from the same origin.
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini (free tier). Leave GEMINI_API_KEY empty to use the
# rule-based fallback classifier (clearly labelled in the UI).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000

# Demo seed password (only used by `npm run db:seed`)
DEMO_PASSWORD=Demo@12345
